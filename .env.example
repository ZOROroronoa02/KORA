DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kora?schema=public"
# Generate a fresh 32-byte key with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
JWT_ACCESS_SECRET=""
# Set the canonical HTTPS origin used by the browser deployment.
KORA_APP_ORIGIN=""
# In production, the trusted edge must remove incoming x-kora-* headers, set the true client IP,
# and HMAC-SHA256-sign that exact IP string using this secret.
KORA_PROXY_SHARED_SECRET=""
REDIS_URL="redis://localhost:6379"
NEXT_PUBLIC_REALTIME_URL="http://localhost:4000"
NEXT_PUBLIC_ASSET_ORIGIN=""

# Optional development seed login. Set these locally; never use shared production credentials.
SEED_OWNER_EMAIL=""
SEED_OWNER_PASSWORD=""
